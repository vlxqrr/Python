    "version": "0.2.0",
    "configurations": [
        {
            "name": "Otwórz index.html w przeglądarce",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/BMI/aplikacja_webowa/index.html"
        },
        {
            "name": "Python: Uruchom Program.py (konsola)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/BMI/aplikacja_konsolowa/Program.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Bieżący plik .py",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}